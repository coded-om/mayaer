# Environment variables
# Local dev: put the server values in server/.env (gitignored — never commit real credentials)
# Vercel:    add them under Project → Settings → Environment Variables

# ── Server / API (required) ──
# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mayaer?appName=Cluster0
# Long random string used to sign login tokens, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Frontend (optional) ──
# Alpha Vantage API key for live stock quotes (falls back to the rate-limited "demo" key)
VITE_ALPHA_VANTAGE_KEY=
